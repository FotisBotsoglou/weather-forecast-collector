APP_NAME="Weather Forecast Collector"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=weather
DB_USERNAME=weather
DB_PASSWORD=weather

CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

WEATHERAPI_KEY=

WEATHER_PROVIDERS=open_meteo,weatherapi
OPEN_METEO_FORECAST_DAYS=7
WEATHERAPI_FORECAST_DAYS=3
WEATHER_HTTP_TIMEOUT=15

WEATHER_SCHEDULE_TIMEZONE=Europe/Athens
WEATHER_SCHEDULE_START=06:00
WEATHER_SCHEDULE_END=12:00

WEATHER_LOCATION_NAME=Thessaloniki
WEATHER_LOCATION_LATITUDE=40.6401
WEATHER_LOCATION_LONGITUDE=22.9444
WEATHER_LOCATION_TIMEZONE=Europe/Athens
